# Copy to .env and fill in, or export these directly in your shell.
# Never commit the real .env file.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides -- defaults are set in src/models.py
# CLAUDE_MODEL=claude-sonnet-5
# OPUS_MODEL=claude-opus-5
# GPT_MODEL=gpt-5.1

# If OPENAI_API_KEY above is actually an OpenRouter key (starts with sk-or-v1-...)
# instead of a native OpenAI key (starts with sk-...), uncomment both of these:
OPENAI_BASE_URL=https://openrouter.ai/api/v1
GPT_MODEL=openai/gpt-5.1
